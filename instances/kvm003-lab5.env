# Lab 5 on kvm003-f3 (~/litevirt-lab5). Copy to lab.env beside lab.sh.
# Built like lab 3 (instances/kvm003-lab3.env); every host-visible value differs
# from labs 1-5:
#   lab 1: seed 8077, ssh 2231-2236, aux ssh 2261.., 10.77.0.x, 52:54:00:77, litevirt-node-N
#   lab 2: seed 8078, ssh 2241-2245, storage ssh 2251-2252, 10.78.0.x, 52:54:00:78, litevirt2-node-N
#   lab 3: seed 8079, ssh 2271-2275, 10.79.0.x, 52:54:00:79, litevirt3-node-N
#   lab 4: seed 8080, ssh 2281-2285, 10.80.0.x, 52:54:00:80, litevirt4-node-N
#   lab 5: seed 8081, ssh 2291-2295, 10.81.0.x, 52:54:00:81, litevirt5-node-N
# Hub mode only (the default). The *_MCAST values below are lab 5's own and only
# switch a LAN on; they would be used solely by a LAB_NET_MODE=mcast rollback.
LAB_NODES=5
LAB_SEEDPORT=8081
LAB_MCAST=230.0.0.81:11881
LAB_SSH_PORT_BASE=2290
LAB_LAN_PREFIX=10.81.0
LAB_MAC_PREFIX=52:54:00:81
LAB_QEMU_NAME=litevirt5-node

# Ubuntu 26.04 (resolute), as on lab 3.
LAB_UBUNTU_RELEASE=resolute

# node-1 has 5 GiB, as on labs 1 and 3; the others take lab.sh's 3072.
LAB_NODE_MEM="1:5120"

# Migration network: node N is 10.81.1.(10+N)/24 on its own hub.
LAB_MIG_MCAST=230.0.1.81:11981
LAB_MIG_PREFIX=10.81.1
