# Lab 2 on kvm003-f3 (~/litevirt-lab2). Copy to lab.env beside lab.sh.
# Every host-visible value differs from lab 1 (~/litevirt-lab, no lab.env):
#   lab 1: seed 8077, mcast 230.0.0.77:11877, ssh 2231-2235, 10.77.0.11-15,
#          MACs 52:54:00:77:0{0,1}:0N, qemu -name litevirt-node-N
LAB_NODES=5
LAB_SEEDPORT=8078
LAB_MCAST=230.0.0.78:11878
LAB_SSH_PORT_BASE=2240
LAB_LAN_PREFIX=10.78.0
LAB_MAC_PREFIX=52:54:00:78
LAB_QEMU_NAME=litevirt2-node

# Shared-storage VMs (lab.sh storage ..., tools/*.sh). Not litevirt hosts.
#   lab2-nfs  10.78.0.21  ssh 2251   NFS + iSCSI target
#   lab2-ceph 10.78.0.22  ssh 2252   single-node Ceph
# Qemu names litevirt2-node-storage-{nfs,ceph}; NICs <mac>:02:N (nat), :03:N (lan).
LAB_STORAGE_PREFIX=lab2
LAB_STORAGE_SSH_PORT_BASE=2250
LAB_STORAGE_NFS_IP=10.78.0.21
LAB_STORAGE_CEPH_IP=10.78.0.22
