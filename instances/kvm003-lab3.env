# Lab 3 on kvm003-f3 (~/litevirt-lab3). Copy to lab.env beside lab.sh.
# Every host-visible value differs from lab 1 (defaults + instances/kvm003-lab1.env)
# and lab 2 (instances/kvm003-lab2.env):
#   lab 1: seed 8077, ssh 2231-2236, aux ssh 2261.., 10.77.0.x, 52:54:00:77, litevirt-node-N
#   lab 2: seed 8078, ssh 2241-2245, storage ssh 2251-2252, 10.78.0.x, 52:54:00:78, litevirt2-node-N
# Hub mode only (the default). The *_MCAST values below are lab 3's own and only
# switch a LAN on; they would be used solely by a LAB_NET_MODE=mcast rollback.
LAB_NODES=5
LAB_SEEDPORT=8079
LAB_MCAST=230.0.0.79:11879
LAB_SSH_PORT_BASE=2270
LAB_LAN_PREFIX=10.79.0
LAB_MAC_PREFIX=52:54:00:79
LAB_QEMU_NAME=litevirt3-node

# Ubuntu 26.04 (resolute): QEMU >= 9.1, libvirt >= 11.2 and userfaultfd
# write-protect for the memory-snapshot tiers. Labs 1 and 2 stay on noble.
LAB_UBUNTU_RELEASE=resolute

# node-1 has 5 GiB, as on lab 1; the others take lab.sh's 3072.
LAB_NODE_MEM="1:5120"

# Migration network: node N is 10.79.1.(10+N)/24 on its own hub.
LAB_MIG_MCAST=230.0.1.79:11979
LAB_MIG_PREFIX=10.79.1
