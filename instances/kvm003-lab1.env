# Lab 1 on kvm003-f3 (~/litevirt-lab). Copy to lab.env there.
#
# Lab 1's identity is lab.sh's defaults (230.0.0.77:11877, ssh 2231.., 10.77.0.x,
# 52:54:00:77:*, litevirt-node-N, seed 8077), so nothing of it is repeated here.
# Everything below is an opt-in extra (see lab.sh "lab extras", README "Lab 1
# extras"); lab 2's lab.env sets none of it, so its nodes boot exactly as before.

# node-6 is the witness (vote-only) host.
LAB_NODES=6

# node-1 was given 5 GiB on 2026-10-10 (6-guest firewall traffic test).
LAB_NODE_MEM="1:5120"

# A QMP socket per node: ACPI power button for the BMC simulators' soft-off.
LAB_NODE_QMP=1

# Emulated hardware on the workers (not the witness): q35 + intel-iommu, igb
# with SR-IOV, NVMe, spare virtio disk, xhci + USB tablet/keyboard.
LAB_NODE_HW=1
LAB_NODE_HW_NODES="1 2 3 4 5"
LAB_IGB_MCAST=230.0.3.77:12177

# Extra networks. Every multicast group:port here is lab 1's own; never reuse
# one in another lab (two labs on one group:port are one L2 segment).
LAB_MIG_MCAST=230.0.1.77:11977
LAB_MIG_PREFIX=10.77.1
LAB_TRUNK_MCAST=230.0.2.77:12077
LAB_LAN6_PREFIX=fd00:77::

# Booted with the legacy cgroup v1 hierarchy (tools/node-extras.sh).
LAB_CGROUP_V1_NODES="2"

# Helper VMs: simulated BMCs, and kanidm + Mailpit.
LAB_AUX_ROLES="bmc idm"
LAB_AUX_SSH_PORT_BASE=2260
LAB_BMC_IP=10.77.0.40
LAB_BMC_IPMI_BASE=40          # node N's IPMI BMC is <lan>.(40+N), UDP 623
LAB_BMC_NODES="1 2 3 4 5 6"
LAB_BMC_AGENT_PORT=8170       # host-side power agent, 127.0.0.1 only
LAB_IDM_IP=10.77.0.50
LAB_IDM_DOMAIN=idm.lab
