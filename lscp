#!/usr/bin/env bash
# lscp <n> <local> <remote> — agent-free scp to lab node N.
# The port base comes from the lab.env beside this script (see lab.sh).
LAB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
unset LAB_SSH_PORT_BASE
# shellcheck source=/dev/null
[[ -f "$LAB/lab.env" ]] && . "$LAB/lab.env"
LAB_SSH_KEY="${LAB_SSH_KEY:-$HOME/.ssh/id_ed25519}"
n="$1"; shift
exec scp -i "$LAB_SSH_KEY" -o IdentityAgent=none -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  -o ConnectTimeout=5 -o LogLevel=ERROR -P "$((${LAB_SSH_PORT_BASE:-2230} + n))" "$1" "root@127.0.0.1:$2"
