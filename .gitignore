# Runtime state — everything here is regenerated by lab.sh
/nodes/
/nodes
/seed-http/
/images/
/images
seed-http.log
seed.pid

# The binary under test is deployed in, never committed
/litevirt

# Private keys never enter the repo
/cluster_key*
*.pem
*.key

# Probe output — contains plaintext admin passwords
/probes/*/evidence.txt
/probes/*/.state/
/probes/*/bcheck/bcheck
/admin-seed-probe.evidence
/.probe-original-password

# A lab instance's identity (see lab.sh); reference copies live in instances/
/lab.env

# Shared-storage credentials (iSCSI CHAP, ceph client keyring) — never commit
/secrets/
/storage/
/storage

# Helper VMs (lab.sh aux): disks and the BMC power agent's runtime files
/aux
/aux/
/bmc-agent.pid
/bmc-agent.log
/bmc-agent.log.stderr

# Virtual LAN hubs (lab.sh "virtual LANs"): sockets, pid files, logs, stats
/hub/
/lanhub/lanhub

# Bundles that carried laptop commits to a lab host (BOOTSTRAP: signed on the laptop)
/.lab*.bundle

# Per-run artifacts in a lab instance dir (lab-build binaries, e2e test
# binaries, run evidence). Kept on disk, never committed.
/runs/
/runs-archive/
/evidence/
/e2e-*.test
/litevirt-int-*
/litevirt-proof-*
/wt-*
