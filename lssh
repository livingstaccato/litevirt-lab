#!/usr/bin/env bash
# lssh <n> [cmd...] — agent-free root ssh into lab node N (1Password-agent-proof).
LAB_SSH_KEY="${LAB_SSH_KEY:-$HOME/.ssh/id_ed25519}"
n="$1"; shift
exec ssh -i "$LAB_SSH_KEY" -o IdentityAgent=none -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  -o ConnectTimeout=5 -o LogLevel=ERROR -p "$((2230 + n))" root@127.0.0.1 "$@"
